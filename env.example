# Copy this file to .env.local and fill in the values.
# For Vercel deployments, add each variable in Project Settings -> Environment Variables.
# Full setup instructions: docs/gcp-setup-guide.md and docs/github-setup-guide.md

# ---------------------------------------------------------------------------
# GitHub API (optional but recommended)
# ---------------------------------------------------------------------------
# Personal access token used when fetching repository data from the GitHub API.
# Without it the API is limited to 60 requests/hour (5,000/hour with a token).
#
# How to obtain:
#   1. Go to GitHub Settings -> Developer settings -> Personal access tokens
#      (https://github.com/settings/tokens)
#   2. Generate new token (classic)
#   3. No scopes needed - the site only reads public repo data
#   4. Copy the token (it is only shown once)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Google Drive content source (required)
# ---------------------------------------------------------------------------
# Email of the Google Cloud service account the site uses to read Drive.
# Found as "client_email" in the service account JSON key file.
# The Drive content folder must be shared with this email as Viewer.
# See docs/gcp-setup-guide.md sections 3-5.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key of the same service account.
# Found as "private_key" in the service account JSON key file.
#
# Format matters:
#   - In .env.local, wrap the whole value in double quotes and keep the
#     literal \n sequences: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   - In Vercel environment variables, paste the key with real line breaks
#     (no surrounding quotes, no escaped \n).
# Requires Node.js 22.x locally (Node 25+ fails RSA key decryption).
GOOGLE_PRIVATE_KEY=

# ID of the Google Drive folder that holds the site content
# (the folder containing the "about" and "projects" subfolders).
#
# How to obtain:
#   1. Open the content folder in Google Drive
#   2. Copy the ID from the URL:
#      https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
#   3. Make sure the folder is shared with the service account email above.
GOOGLE_DRIVE_FOLDER_ID=
